# Dependencies
node_modules/
.pnpm-store/
.pnpm-*

# Build outputs
dist/
build/
.turbo/

# Generated content (produced by scripts/generate-content.mjs at build time)
apps/web/public/generated/

# Test artifacts
packages/midi-web/.test-dist/

# Firebase
.firebase/
.firebaserc

# Environment variables
.env
.env.*
!.env.example
*.local

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript incremental build info
*.tsbuildinfo

# Keep the multilingual implementation plan and its progress records reviewable.
!docs/
docs/*
!docs/I18N-CONTENT-REVIEW.md
!docs/PIANO-IMPLEMENTAZIONE-MULTILINGUA.md
!docs/I18N-INVENTORY.md
!docs/I18N-IMPLEMENTATION-STATUS.md

# Phase 4 content contracts and visual review evidence.
!docs/I18N-CONTENT-PIPELINE.md
!docs/i18n-phase4/

# Phase 5 session coordination and browser verification evidence.
!docs/I18N-LANGUAGE-SESSION.md
!docs/i18n-phase5/

# Phase 7 validation records and contributor instructions.
!docs/I18N-GLOSSARY-IT.md
!docs/I18N-VALIDATION-REPORT.md
!docs/ADDING-A-LANGUAGE.md
!docs/ADDING-A-LANGUAGE.en.md
!docs/i18n-phase7/
!docs/i18n-phase7/logs/*.log
